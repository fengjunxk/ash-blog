---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import Heatmap from '@/components/Heatmap.astro';
import { getPostMetas, heatmapOf, categoriesOf, tagsOf, archiveOf, siteStats } from '@/lib/blog';
import { formatNumber, pct } from '@/lib/utils';
import { TIMELINE } from '@/data/about';

const posts = await getPostMetas();
const stats = siteStats(posts);
const heat = heatmapOf(posts, 182);
const cats = categoriesOf(posts);
const tags = tagsOf(posts);
const years = archiveOf(posts);

const avgWords = Math.round(stats.words / Math.max(1, stats.count));
const avgMinutes = Math.round(posts.reduce((s, p) => s + p.minutes, 0) / Math.max(1, stats.count));
const longest = [...posts].sort((a, b) => b.words - a.words)[0];
const shortest = [...posts].sort((a, b) => a.words - b.words)[0];
const busiestMonth = (() => {
	const map = new Map<string, number>();
	for (const p of posts) {
		const key = `${p.published.getFullYear()}-${String(p.published.getMonth() + 1).padStart(2, '0')}`;
		map.set(key, (map.get(key) ?? 0) + 1);
	}
	return [...map.entries()].sort((a, b) => b[1] - a[1])[0];
})();
const activeDays = heat.filter((d) => d.words > 0).length;
const streak = (() => {
	let best = 0;
	let cur = 0;
	for (const day of heat) {
		if (day.words > 0) {
			cur++;
			best = Math.max(best, cur);
		} else cur = 0;
	}
	return best;
})();
const maxYear = Math.max(1, ...years.map((y) => y.posts.length));
const maxCat = Math.max(1, ...cats.map((c) => c.count));
const topTags = tags.slice(0, 10);

const cards = [
	{ label: '文章总数', value: stats.count, unit: '篇', icon: 'pen' },
	{ label: '累计字数', value: formatNumber(stats.words), unit: '字', icon: 'feather' },
	{ label: '平均每篇', value: formatNumber(avgWords), unit: '字', icon: 'chart' },
	{ label: '平均阅读', value: avgMinutes, unit: '分钟', icon: 'clock' },
	{ label: '标签 / 分类', value: `${stats.tags} / ${stats.categories}`, unit: '', icon: 'tag' },
	{ label: '连续写作', value: streak, unit: '天', icon: 'flame' },
	{ label: '活跃天数', value: activeDays, unit: `/${heat.length}`, icon: 'calendar' },
	{ label: '写作跨度', value: stats.days, unit: '天', icon: 'archive' },
];
---
<BaseLayout title="统计" description="灰羽博客的写作数据：字数、节奏、热力图与排行榜。">
	<header class="page-hero wrap">
		<p class="page-hero__eyebrow"><Icon name="chart" size={13} /> 数据面板</p>
		<h1>写作统计</h1>
		<p>把「写了多少」这件事量化一下，看着还挺有成就感的。</p>
	</header>

	<div class="wrap">
		<div class="stat-grid">
			{cards.map((card) => (
				<div class="stat card card-hover" data-reveal>
					<span class="stat__icon"><Icon name={card.icon} size={15} /></span>
					<div>
						<p class="stat__value">
							{card.value}
							{card.unit && <em>{card.unit}</em>}
						</p>
						<p class="stat__label">{card.label}</p>
					</div>
				</div>
			))}
		</div>

		<section class="panel card" data-reveal>
			<h2 class="panel__title"><Icon name="flame" size={16} /> 写作热力图（近半年）</h2>
			<Heatmap data={heat} />
		</section>

		<div class="two-col">
			<section class="panel card" data-reveal>
				<h2 class="panel__title"><Icon name="chart" size={16} /> 每年产量</h2>
				<ul class="bars">
					{years.map((y) => (
						<li>
							<a href={`/archive/${y.year}/`}>
								<span class="bars__label">{y.year}</span>
								<span class="bars__track">
									<span class="bars__fill" style={`--pct:${pct(y.posts.length, maxYear)}%`} />
								</span>
								<span class="bars__value">{y.posts.length} 篇</span>
							</a>
						</li>
					))}
				</ul>
			</section>

			<section class="panel card" data-reveal>
				<h2 class="panel__title"><Icon name="folder" size={16} /> 分类占比</h2>
				<ul class="bars">
					{cats.map((c) => (
						<li>
							<a href={`/categories/${encodeURIComponent(c.name)}/`}>
								<span class="bars__label bars__label--wide">{c.name}</span>
								<span class="bars__track">
									<span class="bars__fill" style={`--pct:${pct(c.count, maxCat)}%`} />
								</span>
								<span class="bars__value">{pct(c.count, stats.count)}%</span>
							</a>
						</li>
					))}
				</ul>
			</section>
		</div>

		<div class="two-col">
			<section class="panel card" data-reveal>
				<h2 class="panel__title"><Icon name="tag" size={16} /> 标签 Top 10</h2>
				<ul class="tag-rank">
					{topTags.map((t, i) => (
						<li>
							<span class="tag-rank__no">{String(i + 1).padStart(2, '0')}</span>
							<a href={`/tags/${encodeURIComponent(t.name)}/`}>#{t.name}</a>
							<span class="tag-rank__count">{t.count} 篇</span>
							<span class="tag-rank__bar" style={`--pct:${pct(t.count, topTags[0]?.count ?? 1)}%`} />
						</li>
					))}
				</ul>
			</section>

			<section class="panel card" data-reveal>
				<h2 class="panel__title"><Icon name="award" size={16} /> 之最</h2>
				<ul class="records">
					{longest && (
						<li>
							<em>最长的一篇</em>
							<a href={longest.url}>{longest.title}</a>
							<span>{formatNumber(longest.words)} 字 · {longest.minutes} 分钟</span>
						</li>
					)}
					{shortest && (
						<li>
							<em>最短的一篇</em>
							<a href={shortest.url}>{shortest.title}</a>
							<span>{formatNumber(shortest.words)} 字</span>
						</li>
					)}
					{busiestMonth && (
						<li>
							<em>最高产月份</em>
							<span class="records__plain">{busiestMonth[0]} · {busiestMonth[1]} 篇</span>
						</li>
					)}
					<li>
						<em>平均每周</em>
						<span class="records__plain">
							{(stats.count / Math.max(1, stats.days / 7)).toFixed(2)} 篇
						</span>
					</li>
				</ul>
			</section>
		</div>

		<section class="panel card" data-reveal>
			<h2 class="panel__title"><Icon name="clock" size={16} /> 写作历程</h2>
			<ol class="milestones">
				{TIMELINE.map((item) => (
					<li>
						<span class="milestones__year">{item.year}</span>
						<div>
							<strong>{item.title}</strong>
							<p>{item.desc}</p>
						</div>
					</li>
				))}
			</ol>
		</section>
	</div>
</BaseLayout>

<style>
	.stat-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 0.8rem;
	}
	.stat {
		display: flex;
		align-items: center;
		gap: 0.8rem;
		padding: 0.95rem 1rem;
	}
	.stat__icon {
		display: grid;
		place-items: center;
		width: 2.2rem;
		height: 2.2rem;
		flex: none;
		border-radius: 0.7rem;
		background: var(--c-accent-soft);
		color: var(--c-accent-ink);
	}
	.stat__value {
		font-family: var(--font-display);
		font-size: 1.35rem;
		font-weight: 700;
		line-height: 1.1;
		letter-spacing: -0.02em;
	}
	.stat__value em {
		font-style: normal;
		font-size: 0.7rem;
		margin-left: 0.2rem;
		color: var(--c-text-mute);
		font-weight: 500;
	}
	.stat__label {
		margin-top: 0.15rem;
		font-size: 0.72rem;
		color: var(--c-text-mute);
	}
	.panel {
		margin-top: 1rem;
		padding: 1.25rem 1.3rem 1.45rem;
	}
	.panel__title {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		margin-bottom: 1.1rem;
		font-size: 0.95rem;
		font-weight: 700;
	}
	.two-col {
		display: grid;
		gap: 1rem;
	}
	.bars {
		display: grid;
		gap: 0.5rem;
		list-style: none;
		padding: 0;
	}
	.bars a {
		display: grid;
		grid-template-columns: 3rem 1fr auto;
		gap: 0.6rem;
		align-items: center;
		text-decoration: none;
		color: var(--c-text-soft);
	}
	.bars__label {
		font-size: 0.78rem;
		font-variant-numeric: tabular-nums;
		color: var(--c-text-mute);
	}
	.bars__label--wide {
		font-size: 0.8rem;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		color: var(--c-text-soft);
	}
	.bars__track {
		height: 0.55rem;
		border-radius: 999px;
		background: var(--c-surface-2);
		overflow: hidden;
	}
	.bars__fill {
		display: block;
		height: 100%;
		width: var(--pct, 0%);
		border-radius: 999px;
		background: linear-gradient(90deg, var(--c-accent), color-mix(in oklab, var(--c-accent) 45%, transparent));
		transition: width 0.6s var(--ease-soft);
	}
	.bars__value {
		font-size: 0.75rem;
		color: var(--c-text-mute);
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}
	.bars a:hover .bars__label--wide {
		color: var(--c-accent-ink);
	}
	.tag-rank,
	.records {
		display: grid;
		gap: 0.2rem;
		list-style: none;
		padding: 0;
	}
	.tag-rank li {
		position: relative;
		display: grid;
		grid-template-columns: 1.8rem 1fr auto;
		gap: 0.6rem;
		align-items: center;
		padding: 0.5rem 0.6rem;
		border-radius: 0.6rem;
		overflow: hidden;
	}
	.tag-rank li:hover {
		background: var(--c-surface-2);
	}
	.tag-rank__no {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		color: var(--c-text-mute);
	}
	.tag-rank a {
		font-size: 0.86rem;
		color: var(--c-text-soft);
		text-decoration: none;
	}
	.tag-rank a:hover {
		color: var(--c-accent-ink);
	}
	.tag-rank__count {
		font-size: 0.74rem;
		color: var(--c-text-mute);
		font-variant-numeric: tabular-nums;
	}
	.tag-rank__bar {
		position: absolute;
		left: 0;
		bottom: 0;
		height: 2px;
		width: var(--pct, 0%);
		background: color-mix(in oklab, var(--c-accent) 40%, transparent);
	}
	.records {
		gap: 0.7rem;
	}
	.records li {
		display: grid;
		gap: 0.2rem;
		padding-bottom: 0.7rem;
		border-bottom: 1px dashed var(--c-border);
	}
	.records li:last-child {
		border-bottom: 0;
		padding-bottom: 0;
	}
	.records em {
		font-style: normal;
		font-size: 0.72rem;
		color: var(--c-text-mute);
	}
	.records a,
	.records__plain {
		font-size: 0.88rem;
		font-weight: 500;
		color: var(--c-text-soft);
		text-decoration: none;
	}
	.records a:hover {
		color: var(--c-accent-ink);
	}
	.records span {
		font-size: 0.74rem;
		color: var(--c-text-mute);
	}
	.milestones {
		display: grid;
		gap: 1rem;
		list-style: none;
		padding: 0;
	}
	.milestones li {
		display: grid;
		grid-template-columns: 3.2rem 1fr;
		gap: 1rem;
	}
	.milestones__year {
		font-family: var(--font-mono);
		font-size: 0.82rem;
		color: var(--c-accent-ink);
		padding-top: 0.15rem;
		position: relative;
	}
	.milestones__year::after {
		content: '';
		position: absolute;
		left: 0.35rem;
		top: 1.5rem;
		bottom: -1rem;
		width: 1px;
		background: var(--c-border);
	}
	.milestones li:last-child .milestones__year::after {
		display: none;
	}
	.milestones strong {
		font-size: 0.92rem;
		font-weight: 650;
	}
	.milestones p {
		margin-top: 0.25rem;
		font-size: 0.82rem;
		line-height: 1.7;
		color: var(--c-text-mute);
	}
	@media (min-width: 640px) {
		.stat-grid { grid-template-columns: repeat(4, 1fr); }
	}
	@media (min-width: 1000px) {
		.two-col { grid-template-columns: 1fr 1fr; }
	}
</style>
