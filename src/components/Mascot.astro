---
/**
 * 站点的吉祥物：一只戴针织帽、系颈圈的灰猫。
 * 完全用矢量绘制（参考插画的灰粉配色），所以任何尺寸都清晰、体积几乎为零。
 * 想换成自己的头像：把图片丢进 public/，然后用 <img> 替换这个组件即可。
 */
interface Props {
	size?: number;
	/** 显示腮红与爱心（更可爱一点） */
	blush?: boolean;
	class?: string;
	floating?: boolean;
}
const { size = 320, blush = true, class: className = '', floating = true } = Astro.props;
---
<div class:list={['mascot', { 'mascot--float': floating }, className]} style={`--mascot-size:${size}px`}>
	<svg viewBox="0 0 300 300" role="img" aria-label="灰羽的吉祥物：一只戴帽子的灰猫">
		<defs>
			<linearGradient id="mascot-body" x1="0" y1="0" x2="0" y2="1">
				<stop offset="0%" stop-color="var(--mascot-body-a, #d9d1d3)" />
				<stop offset="100%" stop-color="var(--mascot-body-b, #c3b9bd)" />
			</linearGradient>
			<linearGradient id="mascot-hat" x1="0" y1="0" x2="0" y2="1">
				<stop offset="0%" stop-color="#322d38" />
				<stop offset="100%" stop-color="#241f2b" />
			</linearGradient>
			<linearGradient id="mascot-blush" x1="0" y1="0" x2="0" y2="1">
				<stop offset="0%" stop-color="#e8a9b0" stop-opacity="0.75" />
				<stop offset="100%" stop-color="#e8a9b0" stop-opacity="0.25" />
			</linearGradient>
		</defs>

		<!-- 背景光晕 -->
		<circle cx="150" cy="150" r="132" fill="currentColor" opacity="0.06" />
		<circle cx="150" cy="150" r="104" fill="currentColor" opacity="0.05" />

		<!-- 耳朵 -->
		<path d="M74 108 L59 50 L112 82 Z" fill="url(#mascot-body)" stroke="#3b3440" stroke-width="4" stroke-linejoin="round" />
		<path d="M226 108 L241 50 L188 82 Z" fill="url(#mascot-body)" stroke="#3b3440" stroke-width="4" stroke-linejoin="round" />
		<path d="M78 100 L69 66 L101 84 Z" fill="#e7b6bd" opacity="0.85" />
		<path d="M222 100 L231 66 L199 84 Z" fill="#e7b6bd" opacity="0.85" />

		<!-- 头 -->
		<ellipse cx="150" cy="148" rx="89" ry="79" fill="url(#mascot-body)" stroke="#3b3440" stroke-width="4" />

		<!-- 帽子 -->
		<path
			d="M64 118 Q150 -8 236 118 Q150 138 64 118 Z"
			fill="url(#mascot-hat)"
			stroke="#1d1922"
			stroke-width="4"
			stroke-linejoin="round"
		/>
		<path d="M64 118 Q150 138 236 118 L233 98 Q150 118 67 98 Z" fill="#3d3644" opacity="0.9" />
		<ellipse cx="150" cy="116" rx="86" ry="12" fill="#39323f" stroke="#1d1922" stroke-width="3.5" opacity="0.95" />
		<circle cx="150" cy="20" r="13" fill="#8b8090" stroke="#3b3440" stroke-width="3.5" />
		<circle cx="150" cy="20" r="5" fill="#efe9ea" opacity="0.8" />

		<!-- 眼睛 -->
		<path d="M108 142 q13 -17 26 0 q-13 12 -26 0" fill="#5a3038" />
		<path d="M166 142 q13 -17 26 0 q-13 12 -26 0" fill="#5a3038" />
		<circle cx="121" cy="142" r="4.4" fill="#fff" opacity="0.9" />
		<circle cx="179" cy="142" r="4.4" fill="#fff" opacity="0.9" />
		<path d="M108 142 q13 -17 26 0" fill="none" stroke="#3b3440" stroke-width="3.4" stroke-linecap="round" />
		<path d="M166 142 q13 -17 26 0" fill="none" stroke="#3b3440" stroke-width="3.4" stroke-linecap="round" />

		{blush && (
			<>
				<ellipse cx="100" cy="164" rx="16" ry="9" fill="url(#mascot-blush)" />
				<ellipse cx="200" cy="164" rx="16" ry="9" fill="url(#mascot-blush)" />
			</>
		)}

		<!-- 鼻子与嘴 -->
		<path d="M150 156 l-8 7 h16 z" fill="#c98a94" />
		<path d="M150 163 q-10 12 -20 3" fill="none" stroke="#3b3440" stroke-width="3.2" stroke-linecap="round" />
		<path d="M150 163 q10 12 20 3" fill="none" stroke="#3b3440" stroke-width="3.2" stroke-linecap="round" />

		<!-- 胡须 -->
		<path d="M92 152 L60 144 M92 162 L58 162 M92 172 L62 180" stroke="#3b3440" stroke-width="2.6" stroke-linecap="round" opacity="0.65" />
		<path d="M208 152 L240 144 M208 162 L242 162 M208 172 L238 180" stroke="#3b3440" stroke-width="2.6" stroke-linecap="round" opacity="0.65" />

		<!-- 颈圈 -->
		<path d="M88 206 Q150 246 212 206" fill="none" stroke="#2f2a35" stroke-width="11" stroke-linecap="round" />
		<circle cx="150" cy="230" r="9" fill="#8b8090" stroke="#2f2a35" stroke-width="3" />
	</svg>

	{blush && (
		<>
			<span class="mascot__heart mascot__heart--1">♥</span>
			<span class="mascot__heart mascot__heart--2">♥</span>
		</>
	)}
</div>

<style>
	.mascot {
		position: relative;
		width: var(--mascot-size, 320px);
		height: var(--mascot-size, 320px);
		color: var(--c-accent);
		max-width: 100%;
	}
	.mascot svg {
		width: 100%;
		height: 100%;
		display: block;
		filter: drop-shadow(0 18px 30px color-mix(in oklab, var(--c-ink) 14%, transparent));
	}
	.mascot--float svg {
		animation: var(--animate-float);
	}
	.mascot__heart {
		position: absolute;
		font-size: 0.95rem;
		color: var(--c-accent);
		opacity: 0.8;
		animation: var(--animate-heart);
	}
	.mascot__heart--1 {
		top: 22%;
		left: 4%;
		animation-delay: -0.4s;
	}
	.mascot__heart--2 {
		top: 34%;
		right: 3%;
		font-size: 0.7rem;
		animation-delay: -1.1s;
	}
	/* 暗色下头部用深灰，光晕压暗一点，避免糊成一团 */
	:global([data-theme='dark']) .mascot {
		--mascot-body-a: #4a434e;
		--mascot-body-b: #3a343e;
	}
	:global([data-theme='dark']) .mascot svg {
		filter: drop-shadow(0 18px 30px rgb(0 0 0 / 0.45));
		opacity: 0.97;
	}
	:global([data-theme='dark']) .mascot svg > circle {
		opacity: 0.04;
	}
	@media (prefers-color-scheme: dark) {
		:global(:root:not([data-theme='light'])) .mascot {
			--mascot-body-a: #4a434e;
			--mascot-body-b: #3a343e;
		}
		:global(:root:not([data-theme='light'])) .mascot svg {
			filter: drop-shadow(0 18px 30px rgb(0 0 0 / 0.45));
			opacity: 0.97;
		}
		:global(:root:not([data-theme='light'])) .mascot svg > circle {
			opacity: 0.04;
		}
	}
</style>
