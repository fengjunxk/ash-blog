---
import Icon from './Icon.astro';
import type { PostMeta } from '@/lib/blog';
import { formatDate } from '@/lib/utils';

interface Props {
	post: PostMeta;
	variant?: 'default' | 'compact' | 'feature' | 'list';
	index?: number;
}
const { post, variant = 'default', index = 0 } = Astro.props;

const palette = [
	['#efe6e4', '#c9a2a6'],
	['#e8e6ef', '#a49bbd'],
	['#e6eeee', '#93b0ad'],
	['#f1eae0', '#c2a888'],
	['#eceae8', '#9d9691'],
];
const [bg, fg] = palette[index % palette.length]!;
---
<article class:list={['post-card', `post-card--${variant}`]} data-reveal>
	<a href={post.url} class="post-card__link" aria-label={post.title}>
		{variant !== 'compact' && variant !== 'list' && (
			<div class="post-card__cover" style={`--cover-bg:${bg};--cover-fg:${fg}`} aria-hidden="true">
				<svg viewBox="0 0 400 160" preserveAspectRatio="none" class="post-card__pattern">
					<path d="M0 120 Q100 60 200 120 T400 120" fill="none" stroke="currentColor" stroke-width="1.2" opacity="0.5" />
					<path d="M0 140 Q120 88 240 140 T400 140" fill="none" stroke="currentColor" stroke-width="1.2" opacity="0.3" />
					<circle cx="330" cy="46" r="26" fill="none" stroke="currentColor" stroke-width="1.2" opacity="0.35" />
					<circle cx="330" cy="46" r="14" fill="none" stroke="currentColor" stroke-width="1.2" opacity="0.25" />
				</svg>
				<span class="post-card__emoji" set:html={'✦'} />
				<span class="post-card__cat">{post.category}</span>
			</div>
		)}

		<div class="post-card__body">
			<div class="post-card__meta">
				{variant === 'list' && <span class="post-card__cat post-card__cat--inline">{post.category}</span>}
				<time datetime={post.published.toISOString()}>{formatDate(post.published, variant === 'list' ? 'iso' : 'short')}</time>
				<span class="dot" aria-hidden="true">·</span>
				<span class="post-card__read">
					<Icon name="clock" size={12} /> {post.minutes} 分钟
				</span>
				{post.pinned && (
					<span class="post-card__pin" title="置顶">
						<Icon name="pin" size={11} /> 置顶
					</span>
				)}
			</div>

			<h3 class="post-card__title">{post.title}</h3>

			{variant !== 'list' && <p class="post-card__desc">{post.description}</p>}

			<div class="post-card__foot">
				<ul class="post-card__tags">
					{post.tags.slice(0, 3).map((tag) => (
						<li>#{tag}</li>
					))}
				</ul>
				{variant !== 'list' && (
					<span class="post-card__more">
						阅读 <Icon name="arrowRight" size={13} />
					</span>
				)}
			</div>
		</div>
	</a>
</article>

<style>
	.post-card {
		position: relative;
		background: var(--c-surface);
		border: 1px solid var(--c-border);
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-soft);
		overflow: hidden;
		transition: transform 0.35s var(--ease-soft), box-shadow 0.35s var(--ease-soft),
			border-color 0.35s var(--ease-soft);
	}
	.post-card:hover {
		transform: translateY(-3px);
		box-shadow: var(--shadow-lift);
		border-color: var(--c-border-strong);
	}
	.post-card__link {
		display: block;
		height: 100%;
		text-decoration: none;
		color: inherit;
	}
	.post-card__cover {
		position: relative;
		height: 8.2rem;
		background: linear-gradient(140deg, var(--cover-bg), color-mix(in oklab, var(--cover-bg) 60%, white));
		color: var(--cover-fg);
		display: grid;
		place-items: center;
		overflow: hidden;
	}
	.post-card__pattern {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}
	.post-card__emoji {
		position: relative;
		font-size: 1.6rem;
		color: var(--cover-fg);
		opacity: 0.85;
		transition: transform 0.5s var(--ease-spring);
	}
	.post-card:hover .post-card__emoji {
		transform: translateY(-2px) rotate(12deg) scale(1.15);
	}
	.post-card__cat {
		position: absolute;
		left: 0.7rem;
		top: 0.7rem;
		padding: 0.2rem 0.55rem;
		border-radius: 999px;
		background: color-mix(in oklab, white 78%, transparent);
		color: color-mix(in oklab, var(--cover-fg) 70%, #2a2a2a);
		font-size: 0.7rem;
		font-weight: 700;
		backdrop-filter: blur(4px);
	}
	.post-card__cat--inline {
		position: static;
		background: var(--c-accent-soft);
		color: var(--c-accent-ink);
		border: 1px solid color-mix(in oklab, var(--c-accent) 30%, transparent);
		backdrop-filter: none;
	}
	.post-card__body {
		display: flex;
		flex-direction: column;
		gap: 0.55rem;
		padding: 1.05rem 1.15rem 1.15rem;
	}
	.post-card__meta {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.4rem;
		font-size: 0.74rem;
		color: var(--c-text-mute);
	}
	.post-card__meta time {
		font-variant-numeric: tabular-nums;
	}
	.post-card__read {
		display: inline-flex;
		align-items: center;
		gap: 0.2rem;
	}
	.post-card__pin {
		display: inline-flex;
		align-items: center;
		gap: 0.15rem;
		padding: 0.1rem 0.4rem;
		border-radius: 999px;
		background: var(--c-accent-soft);
		color: var(--c-accent-ink);
		font-weight: 600;
	}
	.dot {
		opacity: 0.5;
	}
	.post-card__title {
		font-size: 1.06rem;
		font-weight: 700;
		line-height: 1.4;
		letter-spacing: -0.01em;
		transition: color 0.25s var(--ease-soft);
	}
	.post-card:hover .post-card__title {
		color: var(--c-accent-ink);
	}
	.post-card__desc {
		font-size: 0.85rem;
		line-height: 1.7;
		color: var(--c-text-mute);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.post-card__foot {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.6rem;
		margin-top: auto;
		padding-top: 0.35rem;
	}
	.post-card__tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		list-style: none;
		margin: 0;
		padding: 0;
		font-size: 0.72rem;
		color: var(--c-text-mute);
	}
	.post-card__more {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		font-size: 0.78rem;
		font-weight: 600;
		color: var(--c-accent-ink);
		opacity: 0;
		transform: translateX(-4px);
		transition: all 0.28s var(--ease-soft);
		white-space: nowrap;
	}
	.post-card:hover .post-card__more {
		opacity: 1;
		transform: none;
	}

	/* 变体：竖版大卡（首页头条） */
	.post-card--feature .post-card__cover {
		height: 12rem;
	}
	.post-card--feature .post-card__title {
		font-size: 1.35rem;
	}
	.post-card--feature .post-card__desc {
		-webkit-line-clamp: 3;
		font-size: 0.9rem;
	}

	/* 变体：紧凑（侧栏） */
	.post-card--compact .post-card__body {
		padding: 0.75rem 0.9rem;
		gap: 0.3rem;
	}
	.post-card--compact .post-card__title {
		font-size: 0.92rem;
	}
	.post-card--compact .post-card__desc {
		display: none;
	}

	/* 变体：列表行 */
	.post-card--list {
		border-radius: var(--radius-md);
		box-shadow: none;
		background: transparent;
		border-color: transparent;
		border-bottom: 1px solid var(--c-border);
	}
	.post-card--list:hover {
		background: var(--c-surface);
		border-color: var(--c-border);
		transform: none;
		box-shadow: var(--shadow-soft);
	}
	.post-card--list .post-card__body {
		padding: 0.95rem 1rem;
		gap: 0.35rem;
	}
	.post-card--list .post-card__title {
		font-size: 1rem;
	}
	.post-card--list .post-card__foot {
		display: none;
	}
</style>
