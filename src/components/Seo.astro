---
/**
 * 统一 SEO 出口：title / description / canonical / OG / Twitter / JSON-LD
 * 所有页面通过 BaseLayout 自动带上，文章页额外带文章元信息。
 */
interface Props {
	title?: string;
	description?: string;
	type?: 'website' | 'article';
	publishedTime?: Date;
	modifiedTime?: Date;
	tags?: string[];
	image?: string;
	noindex?: boolean;
	jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}
import { SITE, AUTHOR, FEATURES } from '@/data/site';

const {
	title,
	description = SITE.description,
	type = 'website',
	publishedTime,
	modifiedTime,
	tags = [],
	image,
	noindex = false,
	jsonLd,
} = Astro.props;

const siteName = SITE.title;
const fullTitle = title ? `${title} · ${siteName}` : `${siteName} — ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url).href;

/** 每页专属分享图由 src/pages/og/[...path].png.ts 在构建期生成：
 *  /blog/x/ → /og/blog/x.png，/stats/ → /og/stats/index.png
 *  在 site.ts 里把 FEATURES.ogImages 设为 false 就统一用默认图。 */
const ogPath = Astro.url.pathname.replace(/\/+$/, '');
const generatedOg = FEATURES.ogImages ? `/og${ogPath || '/index'}.png` : '/og-default.png';
const ogImage = image ?? generatedOg;

const baseLd = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: siteName,
	url: SITE.url,
	description: SITE.description,
	author: { '@type': 'Person', name: AUTHOR.name },
	inLanguage: SITE.lang,
};
const extraLd = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const ldBlocks = [baseLd, ...extraLd];
---
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex,nofollow" />}
<meta name="generator" content={Astro.generator} />
<meta name="author" content={AUTHOR.name} />
<meta name="theme-color" content="#f7f3f0" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#22202a" media="(prefers-color-scheme: dark)" />
<meta name="color-scheme" content="light dark" />

{tags.length > 0 && <meta name="keywords" content={tags.join(', ')} />}
<meta property="og:type" content={type} />
<meta property="og:site_name" content={siteName} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content="zh_CN" />
<meta property="og:image" content={new URL(ogImage, SITE.url).href} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
{tags.map((t) => <meta property="article:tag" content={t} />)}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={new URL(ogImage, SITE.url).href} />

<link rel="alternate" type="application/rss+xml" title={`${siteName} · RSS`} href={new URL('rss.xml', SITE.url).href} />
<link rel="sitemap" type="application/xml" href={new URL('sitemap-index.xml', SITE.url).href} />

{ldBlocks.map((block) => <script type="application/ld+json" set:html={JSON.stringify(block)} />)}
